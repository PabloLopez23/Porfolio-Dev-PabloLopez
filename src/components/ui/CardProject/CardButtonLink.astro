---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const props = Astro.props;
---

<a
  {...props}
  target="_blank"
  class="inline-flex min-h-11 grow items-center justify-center rounded-md bg-[var(--secondary-color)] p-2 text-white transition-colors duration-150 hover:bg-[var(--primary-color)] hover:text-[#16171f]"
>
  <slot />
</a>
