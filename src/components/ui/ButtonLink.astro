---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { class: className, ...props } = Astro.props;
---

<a
  {...props}
  target="_blank"
  class:list={[
    "inline-flex items-center text-sm justify-center rounded-md bg-[var(--primary-color)] px-4 py-2 text-[#16171f] transition-colors duration-150 hover:bg-transparent hover:text-[var(--primary-color)] hover:outline hover:outline-2 hover:outline-[var(--primary-color)] group hover:cursor-pointer font-semibold",
    className,
  ]}
>
  <slot />
</a>
