---
import ButtonLink from "@ui/ButtonLink.astro";
import { type TimeLineData } from "./time-line.interface";

interface Props {
  extraDetails: TimeLineData["extraDetails"];
}

const { extraDetails } = Astro.props;
---

<div class="timeline-body">
  {
    extraDetails?.map(({ description, title, url }) => {
      return (
        <div>
          {title && <h4>{title}</h4>}
          {description && <p>{description}</p>}
          {url && <ButtonLink href={url}>Ver más</ButtonLink>}
        </div>
      );
    })
  }
</div>

<style>
  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  .timeline-body > div {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  h4 {
    color: var(--text-color);
    font-size: 1rem;
  }

  p {
    color: var(--text-color);
    font-size: 1rem;
  }
</style>
