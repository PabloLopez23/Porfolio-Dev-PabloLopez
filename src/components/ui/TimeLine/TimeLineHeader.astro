---
import type { TimeLineData } from "./time-line.interface";

interface Props {
  subTitle?: TimeLineData["subTitle"];
  date?: TimeLineData["date"];
  title?: TimeLineData["title"];
}

const { subTitle, date, title } = Astro.props;
---

<header>
  {title && <h3>{title}</h3>}

  {
    subTitle && (
      <a
        href={subTitle.url}
        target="_blank"
        class="timeline-link"
      >
        {subTitle.title}
      </a>
    )
  }

  {
    date && (
      <time>
        {date}
      </time>
    )
  }
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  h3 {
    margin: 0;
    color: var(--primary-color);
    font-size: 1.2rem;
  }

  .timeline-link {
    width: fit-content;
    color: var(--text-color);
    font-size: 0.95rem;
    font-weight: 700;
    opacity: 0.78;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .timeline-link:hover {
    color: var(--primary-color);
    opacity: 1;
    text-decoration: underline;
  }

  time {
    color: var(--muted-text-color);
    font-size: 0.9rem;
  }
</style>
