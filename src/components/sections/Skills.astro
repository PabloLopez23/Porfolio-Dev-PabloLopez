---
import { mockProjects } from "@data/projects.mock";

const cybersecuritySkills = [
  "Blue Team",
  "Cloud Security",
  "Cybersecurity",
  "Pentesting",
  "Web Security",
  "Vulnerability Analysis",
  "Burp Suite",
  "Nmap",
  "Wireshark",
  "Linux",
  "SIEM",
];

const skills = Array.from(
  new Set([...mockProjects.flatMap((project) => project.skills), ...cybersecuritySkills])
).slice(0, 24);
---

<section
  id="skills"
  class="portfolio-section animate-pulse-fade-in animate-duration-500 animate-delay-300"
>
  <h2>Skills</h2>

  <div class="carousel-container" aria-label="Tecnologías principales">
    <ul class="skills-list">
      {skills.map((skill) => <li>{skill}</li>)}
      {skills.map((skill) => <li aria-hidden="true">{skill}</li>)}
    </ul>
  </div>
</section>

<style>
  .carousel-container {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
  }

  .skills-list {
    display: flex;
    width: max-content;
    flex-wrap: nowrap;
    gap: 1rem;
    list-style: none;
    animation: carousel 22s linear infinite;
  }

  .skills-list:hover {
    animation-play-state: paused;
  }

  .skills-list li {
    flex: 0 0 auto;
    min-width: 8rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(219, 196, 4, 0.65);
    border-radius: 5px;
    background: var(--surface-color);
    color: var(--text-color);
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .skills-list li:hover {
    color: var(--primary-color);
    transform: scale(1.06);
  }

  @keyframes carousel {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
</style>
