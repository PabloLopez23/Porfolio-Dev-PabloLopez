---
import SocialButtonLinks from "@ui/SocialButtonLinks.astro";
---

<section class="footer-content animate-pulse-fade-in animate-duration-500 animate-delay-500">
  <p>&copy; 2026 Pablo López</p>
  <SocialButtonLinks />
</section>

<style>
  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    color: var(--text-color);
    text-align: center;
  }

  p {
    color: var(--text-color);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
