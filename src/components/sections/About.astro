---
import SocialButtonLinks from "@ui/SocialButtonLinks.astro";

const email = "pabloexelopezh@gmail.com";
---

<script>
  import { copyTextToClipboard } from "../../utils/copy-text-to-clipboard.util.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const button = document.querySelector("#btn-copy-text") as HTMLButtonElement;
    const toast = document.getElementById("toast") as HTMLDivElement;

    button?.addEventListener("click", () => {
      button.disabled = true;
      copyTextToClipboard("pabloexelopezh@gmail.com");
      showToast();
    });

    function showToast() {
      toast?.classList.toggle("show");

      setTimeout(() => {
        toast?.classList.toggle("show");
        button.disabled = false;
      }, 1500);
    }
  });
</script>

<section id="hero" class="animate-pulse-fade-in animate-duration-500">
  <header class="hero-header">
    <picture>
      <img
        src="https://picsum.photos/id/4/750/200"
        alt="Banner tecnologico"
        loading="lazy"
        width="750"
        height="200"
      />
    </picture>
  </header>

  <picture class="hero-logo">
    <img src="/mifoto.png" alt="Foto de Pablo Lopez" width="200" height="200" />
  </picture>

  <div class="hero-content">
    <div class="hero-socials">
      <SocialButtonLinks />
    </div>

    <p class="eyebrow">Software Developer | Cybersecurity | Pentester</p>
    <h1>Pablo Lopez</h1>
    <p class="summary">
      Desarrollador de software con formacion en Frontend y Backend, actualmente
      especializandome en Ciberseguridad con foco en Pentesting, Seguridad Web y
      Analisis de Vulnerabilidades. Trabajo con React, Node.js, TypeScript,
      Linux, Burp Suite, Nmap y Wireshark para construir software entendiendo
      tambien su superficie de seguridad.
    </p>

    <div class="hero-actions">
      <button id="btn-copy-text" class="primary-action" type="button">Email</button>
      <a class="primary-action secondary" href="cv.pdf">Descargar CV</a>
      <a class="primary-action secondary" href={`mailto:${email}`}>Contactarme</a>
    </div>
  </div>
</section>

<style>
  #hero {
    width: 100%;
    display: grid;
    grid-template-areas:
      "headerHero headerHero"
      "pictureHero contentHero";
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 33px;
  }

  .hero-header {
    grid-area: headerHero;
    width: 100%;
  }

  .hero-header picture {
    display: block;
    width: 100%;
    aspect-ratio: 750 / 200;
    overflow: hidden;
    border-radius: 7px;
    outline: 1px solid rgba(255, 255, 255, 0.24);
  }

  .hero-header img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero-logo {
    grid-area: pictureHero;
    width: 100%;
    max-width: 200px;
    margin-top: -30px;
    overflow: hidden;
    border-radius: 50%;
    aspect-ratio: 1 / 1;
  }

  .hero-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 2px solid #5a5353;
    border-radius: 50%;
  }

  .hero-content {
    grid-area: contentHero;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .hero-socials {
    display: flex;
    justify-content: flex-end;
  }

  .eyebrow {
    color: var(--primary-color);
    font-weight: 700;
  }

  .summary {
    max-width: 720px;
    color: var(--text-color);
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.35rem;
  }

  .secondary {
    background: var(--secondary-color);
    color: #fff;
  }

  @media (max-width: 768px) {
    #hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero-logo {
      margin-top: -42px;
      max-width: 168px;
    }

    .hero-content {
      align-items: center;
    }

    .hero-socials {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>
